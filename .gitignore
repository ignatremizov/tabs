# If your editor or operating system generates extra files,
# those should be listed in your personal .gitignore file,
# like ~/.config/git/ignore .
# Project-specific .gitignore files need only project-specific patterns.

# Backup and temporary files
*~
*.old
*.bak
*.tmp
*.temp
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project
*.log
diff.txt

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Editor directories and files
.vscode/
.idea/
*.code-workspace
.project
.classpath
.settings/
.history/

# shell environment, usually for personal or private settings
.env
.env.*
!.env.sample

# generated by build / release processes
build/
dist/
.build
.version

# deployed stable version(s) currently in use
active/

# other build artifacts
coverage/
ignore/

# Project-specific
todo.otl
VERSION_BUILD

# AI workflows
.codex/
agents/
.worktrees/
delegate.sh
PRD.md
